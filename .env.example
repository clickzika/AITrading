# AITrading — Environment Variables Template
# Copy to .env and fill in your values. NEVER commit .env to git.

# ── Anthropic / Claude ───────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── MT5 Credentials ──────────────────────────────────
MT5_LOGIN=12345678
MT5_PASSWORD=your_mt5_password
MT5_SERVER=YourBroker-Demo
MT5_PATH=C:\Program Files\MetaTrader 5\terminal64.exe

# ── Database (TimescaleDB / PostgreSQL) ──────────────
DATABASE_URL=postgresql://trader:password@localhost:5432/aitrading
DB_HOST=localhost
DB_PORT=5432
DB_NAME=aitrading
DB_USER=trader
DB_PASSWORD=your_db_password

# ── Redis ─────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
REDIS_HOST=localhost
REDIS_PORT=6379

# ── FastAPI ───────────────────────────────────────────
API_SECRET_KEY=your_jwt_secret_key_here
API_HOST=0.0.0.0
API_PORT=8000
API_DEBUG=false

# ── TradingView Webhook ───────────────────────────────
TRADINGVIEW_WEBHOOK_SECRET=your_webhook_secret

# ── Economic Calendar (for news trading) ─────────────
FOREX_FACTORY_API_KEY=optional

# ── Risk Management Defaults ─────────────────────────
MAX_DAILY_LOSS_USD=200
MAX_OPEN_POSITIONS=5
DEFAULT_LOT_SIZE=0.01
